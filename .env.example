# Database — Neon / PostgreSQL
# Dashboard Neon → Connection Details → Connection string (psql / Node.js)
#
# Langkah mengaktifkan:
#   1. Buat project di https://neon.tech lalu salin connection string.
#   2. Simpan sebagai .env.local (lihat contoh di bawah).
#   3. Terapkan skema + buat akun admin pertama: npm run db:setup
#   4. Jalankan server: npm run dev
#
# DATABASE_URL wajib diisi; aplikasi tidak berjalan tanpa koneksi database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Akun admin pertama (dipakai saat npm run db:setup, hanya jika belum ada admin).
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin1207
ADMIN_NAME=Administrator
